# Copy this file to .env and fill in real values. Never commit the real .env file.

# Local PostgreSQL (or Docker Compose):
DB_URL=jdbc:postgresql://localhost:5432/notesapp
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Supabase PostgreSQL (Production on Vercel — use Session or Transaction Pooler for IPv4 compatibility):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# DB_USERNAME=postgres.<your-project-ref>
# DB_PASSWORD=<your-supabase-db-password>

# Must be a long, random string (32+ characters) — used to sign JWTs.
# You can generate one with: openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# Comma-separated frontend origins allowed by CORS (no trailing slashes).
# On unified Vercel deployment, same-origin /api requests do not need CORS,
# but keep your Vercel URL here if needed (e.g. https://your-app.vercel.app).
FRONTEND_URL=http://localhost:5173
